# Cloudflare : mise en cache
/audio/*.mp3
  Cache-Control: public, max-age=86400
/audio/manifest.json
  Cache-Control: public, max-age=300
/js/*
  Cache-Control: public, max-age=300
/css/*
  Cache-Control: public, max-age=300
# Application installable : le service worker et sa liste sont toujours revalidés
/sw.js
  Cache-Control: no-cache
/js/pwa-files.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=300
